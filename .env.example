# Local development: copy to .env. On Vercel, configure these in Project Settings.
# AI Gateway uses Vercel OIDC in deployments. Set AI_GATEWAY_API_KEY only outside Vercel.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4o-mini
AI_GATEWAY_TTS_MODEL=openai/tts-1

# Optional: prebuilt Vercel Sandbox snapshot containing Agent Browser + Chrome.
AGENT_BROWSER_SNAPSHOT_ID=
# Optional direct OpenAI speech preserves MP3 chunk streaming.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Connect Neon Postgres and Vercel Blob for persistent cloud storage.
DATABASE_URL=
BLOB_STORE_ID=
# Required for direct browser uploads of large recordings.
BLOB_READ_WRITE_TOKEN=

# Clerk authentication. Use keys from one Clerk instance per environment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe Billing. Use test keys for local/preview and live keys for production.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_PORTAL_CONFIGURATION=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3377

PORT=3377
HOST=127.0.0.1
DATA_DIR=data
